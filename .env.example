# ===== 服务配置 =====
PORT=3000

# ===== 大模型 API Key（至少配置一个；也可以登录后在页面「🔑 我的密钥」里按账号配置）=====
# DeepSeek 平台: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# 阿里云百炼(DashScope): https://bailian.console.aliyun.com
QWEN_API_KEY=

# ===== 默认模型服务商（deepseek | qwen）=====
DEFAULT_PROVIDER=deepseek

# ===== 演示模式：无任何可用 Key 时设为 1，用内置示例数据体验完整界面 =====
MOCK_MODE=1

# ===== 可选：数据文件位置（默认 src/data/db.json）=====
# AI_RECIPE_DB=./src/data/db.json

# ===== 微信小程序（上线小程序时必填）=====
# mp.weixin.qq.com → 开发管理 → 开发设置
WX_APPID=
WX_SECRET=
