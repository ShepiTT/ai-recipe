<view class="page">
  <view class="logo">🍳</view>
  <view class="brand">AI 智能菜谱</view>
  <view class="muted brand-sub">登录后可保存口味记忆与生成历史</view>

  <view class="card">
    <!-- 微信一键登录 -->
    <block wx:if="{{wxAvailable}}">
      <button class="primary-btn" loading="{{busy}}" bindtap="loginWeixin">微信一键登录</button>
      <view class="divider"><text class="muted">或用账号登录</text></view>
    </block>

    <!-- 账号密码 -->
    <view class="tabs">
      <view class="tab {{mode === 'login' ? 'on' : ''}}" data-mode="login" bindtap="switchMode">登 录</view>
      <view class="tab {{mode === 'register' ? 'on' : ''}}" data-mode="register" bindtap="switchMode">注 册</view>
    </view>

    <view class="field">
      <text class="field-label">用户名</text>
      <input class="input" value="{{username}}" bindinput="onUsername"
             placeholder="2-24 位中文/字母/数字/下划线" placeholder-class="ph" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input class="input" password value="{{password}}" bindinput="onPassword"
             placeholder="至少 4 位" placeholder-class="ph" />
    </view>

    <view class="err" wx:if="{{error}}">{{error}}</view>
    <button class="primary-btn" loading="{{busy}}" bindtap="submit">
      {{mode === 'login' ? '登 录' : '注 册'}}
    </button>
  </view>

  <view class="muted tip">
    没配微信 AppID 时用账号密码登录即可，与网页版是同一套账号。
  </view>
</view>
