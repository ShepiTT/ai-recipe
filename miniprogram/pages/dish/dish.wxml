<view class="page">

  <view class="empty" wx:if="{{loading}}">
    <text class="empty-icon">🍳</text>
    <view>正在编写「{{name}}」的做法…</view>
    <view class="muted" style="margin-top:12rpx">首次生成要等一会儿</view>
  </view>

  <view class="empty" wx:elif="{{error}}">
    <text class="empty-icon">😵</text>
    <view>{{error}}</view>
    <view class="ghost-btn" style="margin-top:32rpx" bindtap="retry">重试</view>
  </view>

  <block wx:elif="{{detail}}">
    <view class="card">
      <view class="dish-head">
        <text class="dish-title">{{detail.name}}</text>
        <view class="fb-row">
          <text class="fb" data-act="like" bindtap="feedback">👍</text>
          <text class="fb" data-act="dislike" bindtap="feedback">👎</text>
        </view>
      </view>
      <view class="muted" wx:if="{{detail.intro}}">{{detail.intro}}</view>
      <view class="pills">
        <text class="pill" wx:if="{{detail.difficulty}}">难度：{{detail.difficulty}}</text>
        <text class="pill" wx:if="{{detail.time}}">耗时：{{detail.time}}</text>
        <text class="pill" wx:if="{{detail.servings}}">{{detail.servings}} 人份</text>
        <text class="pill" wx:if="{{detail.mock}}">演示数据</text>
      </view>
    </view>

    <view class="card" wx:if="{{detail.ingredients.length}}">
      <view class="section-title">🥬 食材</view>
      <view class="ing-row" wx:for="{{detail.ingredients}}" wx:key="name">
        <text class="ing-n">{{item.name}}</text>
        <text class="ing-a">{{item.amount}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{detail.seasoning.length}}">
      <view class="section-title">🧂 调料</view>
      <view class="ing-row" wx:for="{{detail.seasoning}}" wx:key="name">
        <text class="ing-n">{{item.name}}</text>
        <text class="ing-a">{{item.amount}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{detail.steps.length}}">
      <view class="section-title">👨‍🍳 做法步骤</view>
      <view class="step" wx:for="{{detail.steps}}" wx:key="*this">
        <text class="step-no">{{index + 1}}</text>
        <text class="step-text">{{item}}</text>
      </view>
    </view>

    <view class="tips-box" wx:if="{{detail.tips}}">💡 {{detail.tips}}</view>
    <view class="nutrition-box" wx:if="{{detail.nutrition}}">🥗 {{detail.nutrition}}</view>

    <view class="ghost-btn" style="width:100%;text-align:center;box-sizing:border-box;margin-top:24rpx"
          bindtap="copyAll">📋 复制做法</view>
  </block>

</view>
