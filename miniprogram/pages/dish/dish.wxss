.dish-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.dish-title { font-size: 40rpx; font-weight: 800; }
.fb-row { display: flex; gap: 12rpx; }
.fb { padding: 8rpx 12rpx; font-size: 32rpx; }

.pills { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.pill {
  padding: 6rpx 20rpx; font-size: 23rpx; color: var(--ink-soft);
  background: var(--panel-sunk); border: 1rpx solid var(--line); border-radius: 999rpx;
}

.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; color: var(--primary-dark); }

/* 食材：名字左、用量右，用量允许换行不挤压名字 */
.ing-row {
  display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx;
  padding: 16rpx 20rpx; margin-bottom: 10rpx;
  background: var(--panel-sunk); border-radius: 12rpx;
}
.ing-n { flex: 0 0 auto; max-width: 100%; font-size: 27rpx; word-break: break-all; }
.ing-a {
  flex: 1 1 auto; text-align: right;
  font-size: 26rpx; font-weight: 700; color: var(--primary-dark); word-break: break-all;
}

/* 步骤 */
.step { display: flex; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx dashed var(--line); }
.step:last-child { border-bottom: none; }
.step-no {
  flex: 0 0 auto;
  width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center;
  font-size: 24rpx; font-weight: 700; color: #fff; border-radius: 50%;
  background: linear-gradient(120deg, var(--primary), var(--accent));
}
.step-text { flex: 1; font-size: 28rpx; line-height: 1.65; }

.tips-box {
  padding: 22rpx 24rpx; margin-bottom: 16rpx; font-size: 26rpx;
  color: var(--amber); background: var(--amber-soft);
  border: 1rpx solid #f3e6bd; border-radius: 16rpx;
}
.nutrition-box {
  padding: 22rpx 24rpx; font-size: 26rpx;
  color: var(--green); background: #e8f5ec;
  border: 1rpx solid #bfe0cb; border-radius: 16rpx;
}
